# 素材・動画・作業ファイルはGitに入れない
footage/*
!footage/.gitkeep
output/*.mp4
output/*.mov
output/*.wav
projects/*/work/
*.part.*
__pycache__/
fonts/*
!fonts/.gitkeep

# Remotion
node_modules/

# Whisper のモデル・Remotion／HyperFrames の書き出し
models/
motion/out/
motion/**/renders/
motion/**/.hyperframes/

# HyperFrames の案件フォルダにコピーしたフォント（get_fonts.sh で取得できる）
motion/**/assets/fonts/
